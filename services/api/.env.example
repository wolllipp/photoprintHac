# Скопировать в .env и добавить свой секрет (без него сервер не стартует):
#   uv run python -c "import secrets; print('JWT_SECRET=' + secrets.token_urlsafe(48))" >> .env
# Секрет — не короче 32 символов, свой для каждого стенда; в git не коммитить.
DATABASE_URL=postgresql+asyncpg://picpac:picpac@localhost:5433/picpac
DEMO_MODE=true          # стенд показа: вход по коду 0000 и /dev/*; в продукте — false (по умолчанию)
OTP_DEMO_CODE=0000      # фиксированный код входа — работает только при DEMO_MODE=true
STORAGE_DIR=./storage   # фото; позже MinIO
